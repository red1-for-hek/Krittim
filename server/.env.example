PORT=4000
NODE_ENV=development

# MongoDB Atlas (free M0 tier — no credit card)
# Get at: https://cloud.mongodb.com → create free cluster → connect → copy URI
MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/krittim?retryWrites=true&w=majority

# JWT — generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=<64-byte-hex>
JWT_REFRESH_SECRET=<64-byte-hex-different>
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# OAuth Providers
# Google:  https://console.cloud.google.com → APIs & Services → Credentials → OAuth 2.0
# GitHub:  https://github.com/settings/developers → OAuth Apps → New
# Discord: https://discord.com/developers/applications → New App → OAuth2
GOOGLE_CLIENT_ID=<id>
GOOGLE_CLIENT_SECRET=<secret>
GITHUB_CLIENT_ID=<id>
GITHUB_CLIENT_SECRET=<secret>
DISCORD_CLIENT_ID=<id>
DISCORD_CLIENT_SECRET=<secret>

# AI Providers — R1 Xenon
# xKiro: 2 keys from 2 accounts — if key-1 hits limit, key-2 takes over automatically
# Get at: https://xkiro.com → sign up → API Keys
XKIRO_BASE_URL=https://api.xkiro.com/v1
XKIRO_MODEL=muse-spark-1.3
XKIRO_API_KEY_1=<key-from-xkiro-account-1>
XKIRO_API_KEY_2=<key-from-xkiro-account-2>

# apinex.bond: fallback for R1 Xenon
# Get at: https://apinex.bond → sign up → API section
APINEX_BASE_URL=https://api.apinex.bond/v1
APINEX_MODEL=deepseek-v4.1-flash
APINEX_API_KEY=<key>

# AI Providers — S1 Neon (all FREE, no credit card required)

# 1. Groq — best pick: completely free, no card, ultra fast inference
#    Get at: https://console.groq.com → API Keys → Create Key
#    Free limits: 14,400 req/day, 500,000 tokens/day on llama-3.3-70b
GROQ_API_KEY=<key>
GROQ_MODEL=llama-3.3-70b-versatile

# 2. Together AI — free tier with "-Free" suffix models, no card needed
#    Get at: https://api.together.xyz → sign up → API Keys
TOGETHER_API_KEY=<key>
TOGETHER_MODEL=meta-llama/Llama-3.3-70B-Instruct-Turbo-Free

# 3. OpenRouter — models ending in ":free" are always free, no card for free tier
#    Get at: https://openrouter.ai → sign up → Keys → Create Key
OPENROUTER_API_KEY=<key>
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# CORS
CLIENT_ORIGIN=http://localhost:3000
